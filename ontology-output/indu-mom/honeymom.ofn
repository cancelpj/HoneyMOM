DataPropertyDomain(:workOrderQtyDone :WorkOrder)
DataPropertyRange(:workOrderQtyDone xsd:integer)

# Data Property: :workOrderQtyScrap (报废数量)

AnnotationAssertion(rdfs:label :workOrderQtyScrap "报废数量")
