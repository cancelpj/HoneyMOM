DataPropertyRange(:workshopType xsd:string)

# Data Property: :workstationGroup (工位组)

AnnotationAssertion(rdfs:comment :workstationGroup "同组工位可互相替代(如 CNC、MOLD1)。排产时按工位组整体分配设备与模具。")
AnnotationAssertion(rdfs:label :workstationGroup "工位组")
DataPropertyDomain(:workstationGroup rdfs:Resource)
DataPropertyRange(:workstationGroup xsd:string)



############################
#   Classes
############################

# Class: :Alarm (报警记录)

AnnotationAssertion(rdfs:comment :Alarm "设备报警及其确认与处理,时长计入设备损失。")
AnnotationAssertion(rdfs:label :Alarm "报警记录")

# Class: :Andon (安灯)

AnnotationAssertion(rdfs:comment :Andon "现场异常呼叫,分设备/质量/物料/安全等类型,状态从待响应到处理中到已关闭。可由人工发起或由设备自动触发。")
AnnotationAssertion(rdfs:label :Andon "安灯")

# Class: :Attendance (上下工记录)

AnnotationAssertion(rdfs:comment :Attendance "员工按班次的出勤记录,是工时与人工成本的基础。")
AnnotationAssertion(rdfs:label :Attendance "上下工记录")

# Class: :AuxiliaryMaterial (辅料)

AnnotationAssertion(rdfs:comment :AuxiliaryMaterial "物料类型取值之一:辅料。参与生产但不构成产品主体。")
AnnotationAssertion(rdfs:label :AuxiliaryMaterial "辅料")
SubClassOf(:AuxiliaryMaterial :Material)
DisjointClasses(:AuxiliaryMaterial :Consumable)
DisjointClasses(:AuxiliaryMaterial :FinishedProduct)
DisjointClasses(:AuxiliaryMaterial :RawMaterial)
DisjointClasses(:AuxiliaryMaterial :SemiFinishedMaterial)

# Class: :BillOfMaterials (BOM)

AnnotationAssertion(rdfs:comment :BillOfMaterials "物料清单:一个产品由哪些子件按多少用量组成。多层 BOM 展开是 MRP 运算(netting)的基础。")
AnnotationAssertion(rdfs:label :BillOfMaterials "BOM")

# Class: :Changeover (换型时间)

AnnotationAssertion(rdfs:comment :Changeover "设备由前一产品切换到后一产品所需的准备时长。排产时在上一单产品不同时追加该时长,并产出「换型」提示。")
AnnotationAssertion(rdfs:label :Changeover "换型时间")

# Class: :Consumable (易耗品)

AnnotationAssertion(rdfs:comment :Consumable "物料类型取值之一:易耗品。如刀具、砂料等按消耗扣减的物料。")
AnnotationAssertion(rdfs:label :Consumable "易耗品")
SubClassOf(:Consumable :Material)
DisjointClasses(:Consumable :FinishedProduct)
DisjointClasses(:Consumable :RawMaterial)
DisjointClasses(:Consumable :SemiFinishedMaterial)

# Class: :Customer (客户)

AnnotationAssertion(rdfs:comment :Customer "销售对象,带信用额度与结算方式;信用检查是销售订单状态流转的一环。")
AnnotationAssertion(rdfs:label :Customer "客户")

# Class: :DataSource (数据源)

AnnotationAssertion(rdfs:comment :DataSource "现场设备接入点,协议含 MQTT(UNS)、OPC UA、Modbus TCP。")
AnnotationAssertion(rdfs:label :DataSource "数据源")

# Class: :DefectCode (缺陷代码)

AnnotationAssertion(rdfs:comment :DefectCode "缺陷字典,带类别(铸造/机加/外观/其他)与严重度(致命/严重/轻微),可绑定责任工序用于根因追溯。")
AnnotationAssertion(rdfs:label :DefectCode "缺陷代码")

# Class: :DeliverySchedule (交货计划)

AnnotationAssertion(rdfs:comment :DeliverySchedule "订单行下的分批交货安排,交期是排产的时间锚点。")
AnnotationAssertion(rdfs:label :DeliverySchedule "交货计划")

# Class: :DemandForecast (需求预测)

AnnotationAssertion(rdfs:comment :DemandForecast "物料在某日期的预测需求量,可关联客户。")
AnnotationAssertion(rdfs:label :DemandForecast "需求预测")

# Class: :DowntimePlan (设备停机计划)

AnnotationAssertion(rdfs:comment :DowntimePlan "已登记的设备不可用时段(计划保养、维修、放假停产、试制调试),排产时作为硬约束。")
AnnotationAssertion(rdfs:label :DowntimePlan "设备停机计划")

# Class: :Employee (员工)

AnnotationAssertion(rdfs:comment :Employee "作业人员。能否操作某工序由 OperatorSkill 决定,不由岗位名称决定。")
AnnotationAssertion(rdfs:label :Employee "员工")

# Class: :Equipment (设备)

AnnotationAssertion(rdfs:comment :Equipment "设备台账。带理想节拍(ideal_cycle_s),这是 OEE 性能率的计算基准;额定功率用于能耗分析。设备状态(运行/待机/换型/停机/离线/报废)由采集数据推导。")
AnnotationAssertion(rdfs:label :Equipment "设备")

# Class: :EquipmentStateRecord (设备状态记录)

AnnotationAssertion(rdfs:comment :EquipmentStateRecord "设备状态的时间区间记录(运行/待机/换型/停机),是 OEE 与损失分析的原始依据。
OEE = 可用率 A × 性能率 P × 质量率 Q:
A = 运行时间 / 计划时间;
P = min(1, 理想节拍 × 总产量 / 运行时间);
Q = 合格数 / 总数。
损失分为:停机、换型换刀、待机等待、运行。")
AnnotationAssertion(rdfs:label :EquipmentStateRecord "设备状态记录")

# Class: :FinalInspection (出货检验)

AnnotationAssertion(rdfs:comment :FinalInspection "检验类型取值之一:出货。成品发货前的最终检验。")
AnnotationAssertion(rdfs:label :FinalInspection "出货检验")
SubClassOf(:FinalInspection :InspectionRecord)
DisjointClasses(:FinalInspection :FirstArticleInspection)
DisjointClasses(:FinalInspection :InProcessInspection)
DisjointClasses(:FinalInspection :IncomingInspection)
DisjointClasses(:FinalInspection :PatrolInspection)

# Class: :FinishedProduct (成品)

AnnotationAssertion(rdfs:comment :FinishedProduct "物料类型取值之一:成品。可入库、发运并对应销售订单行。")
AnnotationAssertion(rdfs:label :FinishedProduct "成品")
SubClassOf(:FinishedProduct :Material)
DisjointClasses(:FinishedProduct :RawMaterial)
DisjointClasses(:FinishedProduct :SemiFinishedMaterial)

# Class: :FirstArticleInspection (首件检验)

AnnotationAssertion(rdfs:comment :FirstArticleInspection "检验类型取值之一:首件。首检放行单的证据来源。")
AnnotationAssertion(rdfs:label :FirstArticleInspection "首件检验")
SubClassOf(:FirstArticleInspection :InspectionRecord)
DisjointClasses(:FirstArticleInspection :InProcessInspection)
DisjointClasses(:FirstArticleInspection :IncomingInspection)
DisjointClasses(:FirstArticleInspection :PatrolInspection)

# Class: :FirstArticleRelease (首检放行)

AnnotationAssertion(rdfs:comment :FirstArticleRelease "首检单。触发场景:开工、换型、换刀、换班、维修后。工艺步骤勾选「首检放行」时,该工序在放行前不得量产报工;首检判定不合格则不放行并登记 NCR。")
AnnotationAssertion(rdfs:label :FirstArticleRelease "首检放行")

# Class: :Gauge (量检具)

AnnotationAssertion(rdfs:comment :Gauge "量具/检具台账。带校准到期状态:检验记录要求引用一把在有效期内的量具,过期量具不能用于出具有效检验结论。")
AnnotationAssertion(rdfs:label :Gauge "量检具")

# Class: :GaugeCalibration (校准记录)

AnnotationAssertion(rdfs:comment :GaugeCalibration "量检具的一次校准,含校准日期、结果与到期日;到期后量具不可用于检验。")
AnnotationAssertion(rdfs:label :GaugeCalibration "校准记录")

# Class: :InProcessInspection (过程检验)

AnnotationAssertion(rdfs:comment :InProcessInspection "检验类型取值之一:过程。生产过程中在检验点执行。")
AnnotationAssertion(rdfs:label :InProcessInspection "过程检验")
SubClassOf(:InProcessInspection :InspectionRecord)
DisjointClasses(:InProcessInspection :IncomingInspection)
DisjointClasses(:InProcessInspection :PatrolInspection)

# Class: :IncomingInspection (来料检验)

AnnotationAssertion(rdfs:comment :IncomingInspection "检验类型取值之一:来料。对应采购收货时的进货检验。")
AnnotationAssertion(rdfs:label :IncomingInspection "来料检验")
SubClassOf(:IncomingInspection :InspectionRecord)
DisjointClasses(:IncomingInspection :PatrolInspection)

# Class: :InspectionItem (检验项目)

AnnotationAssertion(rdfs:comment :InspectionItem "模板下的一条待检项:特性代码、量具类型、上下限、关键/特殊特性标记。首检放行的判定依据即这些项目的上下限。")
AnnotationAssertion(rdfs:label :InspectionItem "检验项目")

# Class: :InspectionRecord (检验记录)

AnnotationAssertion(rdfs:comment :InspectionRecord "一次检验的执行结果,结论为合格/不合格/待判。检验类型为单值枚举,故其子类互斥。")
AnnotationAssertion(rdfs:label :InspectionRecord "检验记录")

# Class: :InspectionTemplate (检验模板)

AnnotationAssertion(rdfs:comment :InspectionTemplate "检验的模板定义,按物料或工序适用,含抽样规则。模板下挂检验项目,项目带上下限与关键特性标记。")
AnnotationAssertion(rdfs:label :InspectionTemplate "检验模板")

# Class: :InspectionValue (检验值)

AnnotationAssertion(rdfs:comment :InspectionValue "单个检验项的实测值,绑定量具。合格判定按上下限,判定结论回写到检验记录。")
AnnotationAssertion(rdfs:label :InspectionValue "检验值")

# Class: :KittingRecord (物料齐套)

AnnotationAssertion(rdfs:comment :KittingRecord "工单各物料的齐套状态(齐套/部分/缺料)与预计到料时间。缺料工单在预计到料时间之后才能开工,这是排产的主要输入之一。")
AnnotationAssertion(rdfs:label :KittingRecord "物料齐套")

# Class: :LotHold (批次冻结)

AnnotationAssertion(rdfs:comment :LotHold "对某个批次(炉次)的冻结单。冻结期间:该批次零件禁止报工、禁止出库/移库;解冻时按冻结后的事件流恢复零件真实状态。")
AnnotationAssertion(rdfs:label :LotHold "批次冻结")

# Class: :MaintenancePlan (点检保养计划)

AnnotationAssertion(rdfs:comment :MaintenancePlan "点检/保养/润滑计划,带周期天数与下次到期日,指定负责人。")
AnnotationAssertion(rdfs:label :MaintenancePlan "点检保养计划")

# Class: :MaintenanceRecord (点检保养记录)

AnnotationAssertion(rdfs:comment :MaintenanceRecord "计划的一次执行结果(正常/异常)。")
AnnotationAssertion(rdfs:label :MaintenanceRecord "点检保养记录")

# Class: :Material (物料)

AnnotationAssertion(rdfs:comment :Material "可被生产消耗或对外销售的对象,承载规格、单位、安全库存、单价、单重。物料类型(mtype)在系统中为单值枚举,故其子类互斥。")
AnnotationAssertion(rdfs:label :Material "物料")

# Class: :MaterialIssue (领料退料)

AnnotationAssertion(rdfs:comment :MaterialIssue "工单领用或退回物料的流水,带批次维度。批次冻结期间,出库方向会被拦截。")
AnnotationAssertion(rdfs:label :MaterialIssue "领料退料")

# Class: :MaterialPlan (物料计划参数)

AnnotationAssertion(rdfs:comment :MaterialPlan "物料的采购/制造属性:自制或外购、提前期、最小批量、批量倍数、安全库存、损耗率、默认供应商与默认仓库。MRP 运算按这些参数净算需求。")
AnnotationAssertion(rdfs:label :MaterialPlan "物料计划参数")

# Class: :MaterialRequest (物料申请)

AnnotationAssertion(rdfs:comment :MaterialRequest "缺料时的请领单,挂在工单与仓库上。")
AnnotationAssertion(rdfs:label :MaterialRequest "物料申请")

# Class: :MrpRun (MRP 运算)

AnnotationAssertion(rdfs:comment :MrpRun "一次物料需求计划运算,带计划期与运算状态;新运算取代旧运算。")
AnnotationAssertion(rdfs:label :MrpRun "MRP 运算")

# Class: :MrpSuggestion (MRP 建议)

AnnotationAssertion(rdfs:comment :MrpSuggestion "MRP 净算后的建议(计划生产/计划采购/提前/推迟),带需求 pegging 溯源与产能检查结果。可下发为生产工单或采购订单。")
AnnotationAssertion(rdfs:label :MrpSuggestion "MRP 建议")

# Class: :NonconformanceReport (不合格品)

AnnotationAssertion(rdfs:comment :NonconformanceReport "不合格品报告(NCR),带处置(待处置/返修/报废/让步接收/退供应商)与状态(待处理/评审中/已关闭)。首检不合格时自动登记 NCR 且不予放行。")
AnnotationAssertion(rdfs:label :NonconformanceReport "不合格品")

# Class: :OperatorSkill (人员技能)

AnnotationAssertion(rdfs:comment :OperatorSkill "员工在某工序/工位组上的技能等级(学徒/熟练/骨干/可带教),带有效期。排产时若某工序在某个班次内没有合格操作工,产出约束标记「无合格操作工」。")
AnnotationAssertion(rdfs:label :OperatorSkill "人员技能")

# Class: :Part (在制品)

AnnotationAssertion(rdfs:comment :Part "一件一码的实物追踪对象。状态流转:毛坯库 → 在制 → 检验合格 → 成品入库 → 已发运,旁路有返修中、冻结、报废。
铸造场景下携带炉次、浇包、砂型、型腔、浇注温度、残镁、型砂水分等追溯参数;机加场景下携带加工机床。")
AnnotationAssertion(rdfs:label :Part "在制品")

# Class: :PartEvent (零件事件)

AnnotationAssertion(rdfs:comment :PartEvent "零件在现场的时序事件流(流转、检验、冻结等),与 Part 一对多,按时间回放可重建当前状态。")
AnnotationAssertion(rdfs:label :PartEvent "零件事件")

# Class: :PatrolInspection (巡检)

AnnotationAssertion(rdfs:comment :PatrolInspection "检验类型取值之一:巡检。班中周期性抽查。")
AnnotationAssertion(rdfs:label :PatrolInspection "巡检")
SubClassOf(:PatrolInspection :InspectionRecord)

# Class: :Plant (工厂)

AnnotationAssertion(rdfs:comment :Plant "制造实体,是车间与销售订单/采购订单的收货与发货主体。")
AnnotationAssertion(rdfs:label :Plant "工厂")

# Class: :Process (工序)

AnnotationAssertion(rdfs:comment :Process "可被排产与报工的最小制造步骤(如熔炼、造型浇注、机加工)。工序带标准节拍,是 OEE 性能率与排产时长的计算基准。")
AnnotationAssertion(rdfs:label :Process "工序")

# Class: :ProductionLine (产线)

AnnotationAssertion(rdfs:comment :ProductionLine "车间下的连续生产单元,工位与设备挂靠其上;工单可在产线上排产。")
AnnotationAssertion(rdfs:label :ProductionLine "产线")

# Class: :ProductionReport (报工记录)

AnnotationAssertion(rdfs:comment :ProductionReport "现场产出记录,来源含设备自动、人工、手机扫码、扫码枪、工位终端。系统实际执行的放行闸门( services/gates.py submit_report )依次为:
(1) 幂等键 idem_key 重复提交 → 识别为重复提交,不重复计数;
(2) 零件所属批次处于冻结中 → 阻断;
(3) 本次合格数+不良数必须大于 0;
(4) 不得超过上道工序转来的合格数减去本道已报数(跳序/超量);
(5) 不得超过工序计划量 ×(1+report_over_pct/100)(超计划);
(6) 工序标记首检放行时,须已首检放行;
(7) ECN 停工中的工单 → 阻断。
以上为运行时规则,本体仅记录其语义,不以 OWL 公理表达为可执行约束。")
AnnotationAssertion(rdfs:label :ProductionReport "报工记录")

# Class: :PurchaseOrder (采购订单)

AnnotationAssertion(rdfs:comment :PurchaseOrder "对供应商的采购承诺,收货时转入库并触发来料检验。")
AnnotationAssertion(rdfs:label :PurchaseOrder "采购订单")

# Class: :PurchaseOrderLine (采购订单行)

AnnotationAssertion(rdfs:comment :PurchaseOrderLine "采购明细,带已收/合格入库/不合格数量,不合格部分可退供。")
AnnotationAssertion(rdfs:label :PurchaseOrderLine "采购订单行")

# Class: :PurchaseRequisition (请购单)

AnnotationAssertion(rdfs:comment :PurchaseRequisition "采购需求,可由 MRP 建议生成。")
AnnotationAssertion(rdfs:label :PurchaseRequisition "请购单")

# Class: :Quotation (报价单)

AnnotationAssertion(rdfs:comment :Quotation "对外报价,可转为销售订单。")
AnnotationAssertion(rdfs:label :Quotation "报价单")

# Class: :RawMaterial (原材料)

AnnotationAssertion(rdfs:comment :RawMaterial "物料类型取值之一:原材料。与其他物料类型子类互斥(mtype 单值枚举)。")
AnnotationAssertion(rdfs:label :RawMaterial "原材料")
SubClassOf(:RawMaterial :Material)
DisjointClasses(:RawMaterial :SemiFinishedMaterial)

# Class: :RepairOrder (维修工单)

AnnotationAssertion(rdfs:comment :RepairOrder "维修工单,状态:已报修 → 已派工 → 维修中 → 已修复 → 已验收。未修复完成的工单所涉设备在排产时视为不可用。")
AnnotationAssertion(rdfs:label :RepairOrder "维修工单")

# Class: :ReworkOrder (返修记录)

AnnotationAssertion(rdfs:comment :ReworkOrder "返修单,必须处于「进行中」才能流转结果;返修完成后须复检(引用一条检验记录)并给出复检结论,复检不合格则返修不合格。")
AnnotationAssertion(rdfs:label :ReworkOrder "返修记录")

# Class: :Routing (工艺路线)

AnnotationAssertion(rdfs:comment :Routing "产品的工艺版本,带生效/作废状态;一条路线由若干有序工艺步骤构成,工单下达时冻结引用某一版本。")
AnnotationAssertion(rdfs:label :Routing "工艺路线")

# Class: :RoutingStep (工艺步骤)

AnnotationAssertion(rdfs:comment :RoutingStep "工艺路线上的一道工序。携带决定现场行为的三个开关:是否检验点、是否首检放行、报工方式(设备自动/人工/扫码);并指定工位组与标准节拍。")
AnnotationAssertion(rdfs:label :RoutingStep "工艺步骤")

# Class: :SalesOrder (销售订单)

AnnotationAssertion(rdfs:comment :SalesOrder "客户订单。状态:草稿 → 信用待批 → 已确认 → 部分发货 → 已发完 → 已关闭。按单生产(mto)时,订单行会派生生产工单。")
AnnotationAssertion(rdfs:label :SalesOrder "销售订单")

# Class: :SalesOrderLine (销售订单行)

AnnotationAssertion(rdfs:comment :SalesOrderLine "订单的产品明细行,带数量、单价、交期与已发/已退数量;按单生产时关联到具体工单。")
AnnotationAssertion(rdfs:label :SalesOrderLine "销售订单行")

# Class: :ScheduleProposal (排程调整建议)

AnnotationAssertion(rdfs:comment :ScheduleProposal "what-if 排产假设(设备停机、到料推迟、模具保养、优先级调整)落成的建议,带受影响工单与原因。采纳后写入主数据并重排。")
AnnotationAssertion(rdfs:label :ScheduleProposal "排程调整建议")

# Class: :SemiFinishedMaterial (半成品)

AnnotationAssertion(rdfs:comment :SemiFinishedMaterial "物料类型取值之一:半成品。经一道或多道工序加工后进入下一工序的中间件。")
AnnotationAssertion(rdfs:label :SemiFinishedMaterial "半成品")
SubClassOf(:SemiFinishedMaterial :Material)

# Class: :Shift (班次)

AnnotationAssertion(rdfs:comment :Shift "排产与考勤使用的时间段。active=false 的班次不参与排产,设备只在启用班次内工作。")
AnnotationAssertion(rdfs:label :Shift "班次")

# Class: :Shipment (发运记录)

AnnotationAssertion(rdfs:comment :Shipment "成品发运,对应工单与客户。")
AnnotationAssertion(rdfs:label :Shipment "发运记录")

# Class: :Stock (库存)

AnnotationAssertion(rdfs:comment :Stock "物料在仓库/库位上的当前数量,按批次(lot)分列。冻结批次仍占用库存,但不可出库。")
AnnotationAssertion(rdfs:label :Stock "库存")

# Class: :StockTransaction (出入库记录)

AnnotationAssertion(rdfs:comment :StockTransaction "库存流水:入库/出库/移库/盘点调整。移库含调入仓库。出库与移库方向受批次冻结拦截。")
AnnotationAssertion(rdfs:label :StockTransaction "出入库记录")

# Class: :StorageLocation (库位)

AnnotationAssertion(rdfs:comment :StorageLocation "仓库内的库位,带容量。库存精确到库位。")
AnnotationAssertion(rdfs:label :StorageLocation "库位")

# Class: :Supplier (供应商)

AnnotationAssertion(rdfs:comment :Supplier "供货方,带资格(合格/试用/停用)与绩效得分;停用供应商不能下采购订单。")
AnnotationAssertion(rdfs:label :Supplier "供应商")

# Class: :TagPoint (采集点)

AnnotationAssertion(rdfs:comment :TagPoint "设备点位定义,带地址、类型、量程缩放、采集周期与报警上下限。用途(运行状态/报警/功率/产量/主轴负载/温度/质量值)决定该点位被映射成哪类业务记录;接入时逐点确认语义,确认前不可投产。")
AnnotationAssertion(rdfs:label :TagPoint "采集点")

# Class: :Team (班组)

AnnotationAssertion(rdfs:comment :Team "人员的组织单元,归属某个班次,班组长是排产技能覆盖判断的组织边界。")
AnnotationAssertion(rdfs:label :Team "班组")

# Class: :Tooling (模具夹具)

AnnotationAssertion(rdfs:comment :Tooling "模具/芯盒/夹具/检具。带当前模次与寿命模次。排产约束:同一套模具同一时间只能在一台设备上;保养中的模具要到预计可用时间才能占用;剩余模次不足以完成本单时产出「模具寿命不足」提示。")
AnnotationAssertion(rdfs:label :Tooling "模具夹具")

# Class: :UserAccount (系统用户)

AnnotationAssertion(rdfs:comment :UserAccount "登录账号,绑定员工身份与角色权限;数据范围(工厂/车间/产线)决定其可见对象集合。")
AnnotationAssertion(rdfs:label :UserAccount "系统用户")

# Class: :Warehouse (仓库)

AnnotationAssertion(rdfs:comment :Warehouse "按类型区分原材料库、毛坯库、线边库、成品库、辅料库;委外仓表示供应商处库存。")
AnnotationAssertion(rdfs:label :Warehouse "仓库")

# Class: :WorkOrder (生产工单)

AnnotationAssertion(rdfs:comment :WorkOrder "生产工单是计划与现场的交接口。状态机:草稿 → 已下达 → 生产中 → 已完工 → 已关闭(可转已取消)。
业务约束:工单可因 ECN(工艺变更)被判停工,停工未解除时禁止报工(见 services/exec_doc.py 的 report_gate);该 ECN 模型不在本次本体范围内。")
AnnotationAssertion(rdfs:label :WorkOrder "生产工单")

# Class: :WorkOrderOperation (工单工序)

AnnotationAssertion(rdfs:comment :WorkOrderOperation "工单在工艺路线上的展开,记录计划量/合格量/不良量与实际起止。顺序(seq)是有业务含义的:上一道工序未转来足量合格品时,本道不得超量报工。")
AnnotationAssertion(rdfs:label :WorkOrderOperation "工单工序")

# Class: :Workshop (车间)

AnnotationAssertion(rdfs:comment :Workshop "工厂下的生产单元,按类型区分铸造、机加、仓储等;车间类型决定下辖产线的工艺属性。")
AnnotationAssertion(rdfs:label :Workshop "车间")

# Class: :Workstation (工位)

AnnotationAssertion(rdfs:comment :Workstation "产线上的作业点,可绑定设备。工位组(group)表示可互相替代的同类工位(如 CNC 群组),是排产时并行分配设备与模具的单位。")
AnnotationAssertion(rdfs:label :Workstation "工位")


HasKey(:Equipment () (:equipmentCode))
HasKey(:FirstArticleRelease () (:firstArticleCode))
HasKey(:LotHold () (:lotHoldCode))
HasKey(:NonconformanceReport () (:ncrCode))
HasKey(:WorkOrder () (:workOrderCode))
)