DataPropertyDomain(:username :UserAccount)
DataPropertyRange(:username xsd:string)

# Data Property: :warehouseType (仓库类型)

AnnotationAssertion(rdfs:comment :warehouseType "枚举:原材料库 / 毛坯库 / 线边库 / 成品库 / 辅料库 / 委外仓。")
