# Object Property: :alarmOnEquipment (报警设备)

AnnotationAssertion(rdfs:label :alarmOnEquipment "报警设备")
ObjectPropertyDomain(:alarmOnEquipment :Alarm)
ObjectPropertyRange(:alarmOnEquipment :Equipment)

# Object Property: :appliesToEquipment (适用设备)

AnnotationAssertion(rdfs:label :appliesToEquipment "适用设备")
ObjectPropertyDomain(:appliesToEquipment :OperatorSkill)
ObjectPropertyRange(:appliesToEquipment :Equipment)

# Object Property: :appliesToProduct (适用产品)

AnnotationAssertion(rdfs:comment :appliesToProduct "工艺路线适用的产品(与 BOM 的产品语义一致,但分属不同主数据:一个是物料结构,一个是工艺结构)。")
AnnotationAssertion(rdfs:label :appliesToProduct "适用产品")
ObjectPropertyDomain(:appliesToProduct :Routing)
ObjectPropertyRange(:appliesToProduct :Material)

# Object Property: :attendanceInShift (出勤班次)

AnnotationAssertion(rdfs:label :attendanceInShift "出勤班次")
ObjectPropertyDomain(:attendanceInShift :Attendance)
ObjectPropertyRange(:attendanceInShift :Shift)

# Object Property: :attendanceOfEmployee (出勤员工)

