AnnotationAssertion(rdfs:label :workOrderStatus "工单状态")
FunctionalDataProperty(:workOrderStatus)
DataPropertyDomain(:workOrderStatus :WorkOrder)
DataPropertyRange(:workOrderStatus xsd:string)

# Data Property: :workshopType (车间类型)

AnnotationAssertion(rdfs:comment :workshopType "枚举:铸造 / 机加 / 仓储 / 其他。")
AnnotationAssertion(rdfs:label :workshopType "车间类型")
FunctionalDataProperty(:workshopType)
