    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Customer</IRI>
        <Literal>客户</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
