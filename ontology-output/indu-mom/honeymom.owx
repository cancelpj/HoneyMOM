    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#InProcessInspection</IRI>
        <Literal>过程检验</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#IncomingInspection</IRI>
        <Literal>检验类型取值之一:来料。对应采购收货时的进货检验。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#IncomingInspection</IRI>
        <Literal>来料检验</Literal>
    </AnnotationAssertion>
