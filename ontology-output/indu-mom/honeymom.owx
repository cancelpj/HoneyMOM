    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LotHold</IRI>
        <Literal>批次冻结</Literal>
    </AnnotationAssertion>
