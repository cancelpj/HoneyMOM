        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>单位:千克。</rdfs:comment>
        <rdfs:label>单重</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#userDisplayName -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#userDisplayName">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#UserAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
