        <rdfs:label>语义已确认</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagName -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagName">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>点位名称</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagPeriodMs -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagPeriodMs">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>单位:毫秒。</rdfs:comment>
        <rdfs:label>采集周期</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagRole -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagRole">
