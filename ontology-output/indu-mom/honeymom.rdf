    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#repairDowntimeMinutes">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RepairOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
