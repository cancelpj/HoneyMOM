        <rdfs:label>状态开始</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stepInstruction -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stepInstruction">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RoutingStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>作业指示</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stepIsInspectionPoint -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stepIsInspectionPoint">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RoutingStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>检验点</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stepReportMode -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stepReportMode">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RoutingStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:设备自动 / 人工 / 扫码。决定现场以何种方式产生报工记录。</rdfs:comment>
        <rdfs:label>报工方式</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stepRequiresFirstArticle -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stepRequiresFirstArticle">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RoutingStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>为真时,该工序在首检放行前不得量产报工。</rdfs:comment>
        <rdfs:label>首检放行</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stepSequence -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stepSequence">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>有序值,是「不得跳序报工」与「不得超过上道转来数量」的判定基础。</rdfs:comment>
        <rdfs:label>步骤顺序</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#stockQty -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#stockQty">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>库存数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#suggestionKind -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#suggestionKind">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#MrpSuggestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:计划生产 / 计划采购 / 提前 / 推迟。</rdfs:comment>
        <rdfs:label>建议类型</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#suggestionLevel -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#suggestionLevel">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#MrpSuggestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>多级 BOM 展开后的层级,用于展示净算过程。</rdfs:comment>
        <rdfs:label>BOM 层级</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#suggestionQty -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#suggestionQty">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#MrpSuggestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>建议数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#suggestionStatus -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#suggestionStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#MrpSuggestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:待处理 / 已调整 / 已下达 / 已忽略。</rdfs:comment>
        <rdfs:label>建议状态</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#supplierName -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#supplierName">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Supplier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>供应商名称</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#supplierQualification -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#supplierQualification">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Supplier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:合格 / 试用 / 停用。停用供应商不能下采购订单。</rdfs:comment>
        <rdfs:label>供应商资格</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#supplierRating -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#supplierRating">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Supplier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>供应商绩效</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagAddress -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagAddress">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>点位地址</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagAlarmLower -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagAlarmLower">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>报警下限</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagAlarmUpper -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagAlarmUpper">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>报警上限</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#tagConfirmed -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#tagConfirmed">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#TagPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
