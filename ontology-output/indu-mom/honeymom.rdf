        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Gauge"/>
        <rdfs:label>校准对象</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#changeoverFromProduct -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#changeoverFromProduct">
