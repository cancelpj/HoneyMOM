        <rdfs:label>维修状态</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#reportCode -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#reportCode">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#ProductionReport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
