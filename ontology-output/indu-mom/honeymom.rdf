    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#purchaseOrderCode -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#purchaseOrderCode">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#PurchaseOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
