    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#recheckResult">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#ReworkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:合格 / 不合格。</rdfs:comment>
