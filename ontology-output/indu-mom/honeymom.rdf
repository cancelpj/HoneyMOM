    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#repairLevel -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#repairLevel">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RepairOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:紧急 / 一般。</rdfs:comment>
        <rdfs:label>紧急程度</rdfs:label>
    </owl:DatatypeProperty>
    


