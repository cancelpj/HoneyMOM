        <rdfs:label>寿命模次</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#toolingShots -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#toolingShots">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Tooling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>当前模次</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#toolingStatus -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#toolingStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Tooling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:可用 / 在用 / 保养维修中 / 报废。</rdfs:comment>
