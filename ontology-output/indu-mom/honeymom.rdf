        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:模板/模具 / 芯盒 / 夹具 / 检具 / 其他。</rdfs:comment>
        <rdfs:label>模具类型</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#transactionQty -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#transactionQty">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#StockTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>出入库数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#transactionTime -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#transactionTime">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#StockTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>出入库时间</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#transactionType -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#transactionType">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#StockTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:入库 / 出库 / 移库 / 盘点调整。出库与移库方向受批次冻结拦截。</rdfs:comment>
        <rdfs:label>出入库类型</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#unitPrice -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#unitPrice">
