        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>单位:元。</rdfs:comment>
        <rdfs:label>单价</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#unitWeightKg -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#unitWeightKg">
