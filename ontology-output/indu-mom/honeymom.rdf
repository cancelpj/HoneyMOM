    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#toolingLifeShots -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#toolingLifeShots">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Tooling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
