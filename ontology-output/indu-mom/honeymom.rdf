        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:运行状态 / 报警 / 功率 / 电能 / 产量 / 主轴负载 / 温度 / 质量值 / 其他。用途决定该点位被映射成哪类业务记录。</rdfs:comment>
        <rdfs:label>点位用途</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#templateCode -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#templateCode">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#InspectionTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>检验模板编码</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#templateName -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#templateName">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#InspectionTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>检验模板名称</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#toolingAvailableFrom -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#toolingAvailableFrom">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Tooling"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
