<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/ontology/honeymom#"
     xml:base="https://example.org/ontology/honeymom"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://example.org/ontology/honeymom">
        <rdfs:comment>HoneyMOM 离散制造 MES / MOM 系统的业务本体。对象类型对应业务概念,链接类型对应业务关联,数据属性对应业务属性。建模依据来自源码 honeymom/schema*.py 的实体定义与 honeymom/services/ 中的实际业务规则,不是数据库表的机械镜像。</rdfs:comment>
        <rdfs:label>HoneyMOM 制造运营本体</rdfs:label>
        <owl:versionInfo>0.1.0 — 基于 Indu-mom 仓库 main 分支抽取,2026-11-16</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/ontology/honeymom#alarmOnEquipment -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#alarmOnEquipment">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Alarm"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Equipment"/>
        <rdfs:label>报警设备</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#appliesToEquipment -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#appliesToEquipment">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#OperatorSkill"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Equipment"/>
        <rdfs:label>适用设备</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#appliesToProduct -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#appliesToProduct">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Routing"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <rdfs:comment>工艺路线适用的产品(与 BOM 的产品语义一致,但分属不同主数据:一个是物料结构,一个是工艺结构)。</rdfs:comment>
        <rdfs:label>适用产品</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#attendanceInShift -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#attendanceInShift">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Attendance"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Shift"/>
        <rdfs:label>出勤班次</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#attendanceOfEmployee -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#attendanceOfEmployee">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Attendance"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Employee"/>
        <rdfs:label>出勤员工</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#belongsToRouting -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#belongsToRouting">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#RoutingStep"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Routing"/>
        <rdfs:label>所属工艺路线</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#belongsToTeam -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#belongsToTeam">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Employee"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Team"/>
        <rdfs:label>所属班组</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#belongsToWorkOrder -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#belongsToWorkOrder">
        <owl:inverseOf rdf:resource="https://example.org/ontology/honeymom#hasOperation"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrderOperation"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:label>所属工单</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#bomComponent -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#bomComponent">
        <owl:inverseOf rdf:resource="https://example.org/ontology/honeymom#bomProduct"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#BillOfMaterials"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <rdfs:label>BOM 子件</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#bomProduct -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#bomProduct">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#BillOfMaterials"/>
        <rdfs:range rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <rdfs:comment>BOM 的父件方向,与 bomComponent 互为逆关系。</rdfs:comment>
        <rdfs:label>BOM 产品</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/ontology/honeymom#calibrationForGauge -->

    <owl:ObjectProperty rdf:about="https://example.org/ontology/honeymom#calibrationForGauge">
