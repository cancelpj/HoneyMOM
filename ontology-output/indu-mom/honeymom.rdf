    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#userRoles -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#userRoles">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#UserAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>角色决定页面、按钮与 API 权限。</rdfs:comment>
        <rdfs:label>角色</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#username -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#username">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#UserAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>账号</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#warehouseType -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#warehouseType">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Warehouse"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:原材料库 / 毛坯库 / 线边库 / 成品库 / 辅料库 / 委外仓。</rdfs:comment>
        <rdfs:label>仓库类型</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderCode -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderCode">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>系统自动编号,格式 WO{日期}{流水}。是工单的业务身份。</rdfs:comment>
        <rdfs:label>工单号</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderPriority -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderPriority">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>1 为最高。有限产能排程按优先级与交期排序。</rdfs:comment>
        <rdfs:label>优先级</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderQty -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderQty">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>计划数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderQtyDone -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderQtyDone">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>由报工汇总,系统只读。</rdfs:comment>
        <rdfs:label>完工数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderQtyScrap -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderQtyScrap">
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>报废数量</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workOrderStatus -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workOrderStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#WorkOrder"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:草稿 / 已下达 / 生产中 / 已完工 / 已关闭 / 已取消。由动作驱动,非直接编辑。</rdfs:comment>
        <rdfs:label>工单状态</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workshopType -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workshopType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/ontology/honeymom#Workshop"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>枚举:铸造 / 机加 / 仓储 / 其他。</rdfs:comment>
        <rdfs:label>车间类型</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/ontology/honeymom#workstationGroup -->

    <owl:DatatypeProperty rdf:about="https://example.org/ontology/honeymom#workstationGroup">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>同组工位可互相替代(如 CNC、MOLD1)。排产时按工位组整体分配设备与模具。</rdfs:comment>
        <rdfs:label>工位组</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2000/01/rdf-schema#Resource -->

    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    


    <!-- https://example.org/ontology/honeymom#Alarm -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Alarm">
        <rdfs:comment>设备报警及其确认与处理,时长计入设备损失。</rdfs:comment>
        <rdfs:label>报警记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Andon -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Andon">
        <rdfs:comment>现场异常呼叫,分设备/质量/物料/安全等类型,状态从待响应到处理中到已关闭。可由人工发起或由设备自动触发。</rdfs:comment>
        <rdfs:label>安灯</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Attendance -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Attendance">
        <rdfs:comment>员工按班次的出勤记录,是工时与人工成本的基础。</rdfs:comment>
        <rdfs:label>上下工记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#AuxiliaryMaterial -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#AuxiliaryMaterial">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#Consumable"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#FinishedProduct"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#RawMaterial"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#SemiFinishedMaterial"/>
        <rdfs:comment>物料类型取值之一:辅料。参与生产但不构成产品主体。</rdfs:comment>
        <rdfs:label>辅料</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#BillOfMaterials -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#BillOfMaterials">
        <rdfs:comment>物料清单:一个产品由哪些子件按多少用量组成。多层 BOM 展开是 MRP 运算(netting)的基础。</rdfs:comment>
        <rdfs:label>BOM</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Changeover -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Changeover">
        <rdfs:comment>设备由前一产品切换到后一产品所需的准备时长。排产时在上一单产品不同时追加该时长,并产出「换型」提示。</rdfs:comment>
        <rdfs:label>换型时间</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Consumable -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Consumable">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#FinishedProduct"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#RawMaterial"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#SemiFinishedMaterial"/>
        <rdfs:comment>物料类型取值之一:易耗品。如刀具、砂料等按消耗扣减的物料。</rdfs:comment>
        <rdfs:label>易耗品</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Customer -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Customer">
        <rdfs:comment>销售对象,带信用额度与结算方式;信用检查是销售订单状态流转的一环。</rdfs:comment>
        <rdfs:label>客户</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#DataSource -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#DataSource">
        <rdfs:comment>现场设备接入点,协议含 MQTT(UNS)、OPC UA、Modbus TCP。</rdfs:comment>
        <rdfs:label>数据源</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#DefectCode -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#DefectCode">
        <rdfs:comment>缺陷字典,带类别(铸造/机加/外观/其他)与严重度(致命/严重/轻微),可绑定责任工序用于根因追溯。</rdfs:comment>
        <rdfs:label>缺陷代码</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#DeliverySchedule -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#DeliverySchedule">
        <rdfs:comment>订单行下的分批交货安排,交期是排产的时间锚点。</rdfs:comment>
        <rdfs:label>交货计划</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#DemandForecast -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#DemandForecast">
        <rdfs:comment>物料在某日期的预测需求量,可关联客户。</rdfs:comment>
        <rdfs:label>需求预测</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#DowntimePlan -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#DowntimePlan">
        <rdfs:comment>已登记的设备不可用时段(计划保养、维修、放假停产、试制调试),排产时作为硬约束。</rdfs:comment>
        <rdfs:label>设备停机计划</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Employee -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Employee">
        <rdfs:comment>作业人员。能否操作某工序由 OperatorSkill 决定,不由岗位名称决定。</rdfs:comment>
        <rdfs:label>员工</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Equipment -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Equipment">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/ontology/honeymom#equipmentCode"/>
        </owl:hasKey>
        <rdfs:comment>设备台账。带理想节拍(ideal_cycle_s),这是 OEE 性能率的计算基准;额定功率用于能耗分析。设备状态(运行/待机/换型/停机/离线/报废)由采集数据推导。</rdfs:comment>
        <rdfs:label>设备</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#EquipmentStateRecord -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#EquipmentStateRecord">
        <rdfs:comment>设备状态的时间区间记录(运行/待机/换型/停机),是 OEE 与损失分析的原始依据。
OEE = 可用率 A × 性能率 P × 质量率 Q:
A = 运行时间 / 计划时间;
P = min(1, 理想节拍 × 总产量 / 运行时间);
Q = 合格数 / 总数。
损失分为:停机、换型换刀、待机等待、运行。</rdfs:comment>
        <rdfs:label>设备状态记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#FinalInspection -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#FinalInspection">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#InspectionRecord"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#FirstArticleInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#InProcessInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#IncomingInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#PatrolInspection"/>
        <rdfs:comment>检验类型取值之一:出货。成品发货前的最终检验。</rdfs:comment>
        <rdfs:label>出货检验</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#FinishedProduct -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#FinishedProduct">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#RawMaterial"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#SemiFinishedMaterial"/>
        <rdfs:comment>物料类型取值之一:成品。可入库、发运并对应销售订单行。</rdfs:comment>
        <rdfs:label>成品</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#FirstArticleInspection -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#FirstArticleInspection">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#InspectionRecord"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#InProcessInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#IncomingInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#PatrolInspection"/>
        <rdfs:comment>检验类型取值之一:首件。首检放行单的证据来源。</rdfs:comment>
        <rdfs:label>首件检验</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#FirstArticleRelease -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#FirstArticleRelease">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/ontology/honeymom#firstArticleCode"/>
        </owl:hasKey>
        <rdfs:comment>首检单。触发场景:开工、换型、换刀、换班、维修后。工艺步骤勾选「首检放行」时,该工序在放行前不得量产报工;首检判定不合格则不放行并登记 NCR。</rdfs:comment>
        <rdfs:label>首检放行</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Gauge -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Gauge">
        <rdfs:comment>量具/检具台账。带校准到期状态:检验记录要求引用一把在有效期内的量具,过期量具不能用于出具有效检验结论。</rdfs:comment>
        <rdfs:label>量检具</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#GaugeCalibration -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#GaugeCalibration">
        <rdfs:comment>量检具的一次校准,含校准日期、结果与到期日;到期后量具不可用于检验。</rdfs:comment>
        <rdfs:label>校准记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#InProcessInspection -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#InProcessInspection">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#InspectionRecord"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#IncomingInspection"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#PatrolInspection"/>
        <rdfs:comment>检验类型取值之一:过程。生产过程中在检验点执行。</rdfs:comment>
        <rdfs:label>过程检验</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#IncomingInspection -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#IncomingInspection">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#InspectionRecord"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#PatrolInspection"/>
        <rdfs:comment>检验类型取值之一:来料。对应采购收货时的进货检验。</rdfs:comment>
        <rdfs:label>来料检验</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#InspectionItem -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#InspectionItem">
        <rdfs:comment>模板下的一条待检项:特性代码、量具类型、上下限、关键/特殊特性标记。首检放行的判定依据即这些项目的上下限。</rdfs:comment>
        <rdfs:label>检验项目</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#InspectionRecord -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#InspectionRecord">
        <rdfs:comment>一次检验的执行结果,结论为合格/不合格/待判。检验类型为单值枚举,故其子类互斥。</rdfs:comment>
        <rdfs:label>检验记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#InspectionTemplate -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#InspectionTemplate">
        <rdfs:comment>检验的模板定义,按物料或工序适用,含抽样规则。模板下挂检验项目,项目带上下限与关键特性标记。</rdfs:comment>
        <rdfs:label>检验模板</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#InspectionValue -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#InspectionValue">
        <rdfs:comment>单个检验项的实测值,绑定量具。合格判定按上下限,判定结论回写到检验记录。</rdfs:comment>
        <rdfs:label>检验值</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#KittingRecord -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#KittingRecord">
        <rdfs:comment>工单各物料的齐套状态(齐套/部分/缺料)与预计到料时间。缺料工单在预计到料时间之后才能开工,这是排产的主要输入之一。</rdfs:comment>
        <rdfs:label>物料齐套</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#LotHold -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#LotHold">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/ontology/honeymom#lotHoldCode"/>
        </owl:hasKey>
        <rdfs:comment>对某个批次(炉次)的冻结单。冻结期间:该批次零件禁止报工、禁止出库/移库;解冻时按冻结后的事件流恢复零件真实状态。</rdfs:comment>
        <rdfs:label>批次冻结</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MaintenancePlan -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MaintenancePlan">
        <rdfs:comment>点检/保养/润滑计划,带周期天数与下次到期日,指定负责人。</rdfs:comment>
        <rdfs:label>点检保养计划</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MaintenanceRecord -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MaintenanceRecord">
        <rdfs:comment>计划的一次执行结果(正常/异常)。</rdfs:comment>
        <rdfs:label>点检保养记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Material -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Material">
        <rdfs:comment>可被生产消耗或对外销售的对象,承载规格、单位、安全库存、单价、单重。物料类型(mtype)在系统中为单值枚举,故其子类互斥。</rdfs:comment>
        <rdfs:label>物料</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MaterialIssue -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MaterialIssue">
        <rdfs:comment>工单领用或退回物料的流水,带批次维度。批次冻结期间,出库方向会被拦截。</rdfs:comment>
        <rdfs:label>领料退料</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MaterialPlan -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MaterialPlan">
        <rdfs:comment>物料的采购/制造属性:自制或外购、提前期、最小批量、批量倍数、安全库存、损耗率、默认供应商与默认仓库。MRP 运算按这些参数净算需求。</rdfs:comment>
        <rdfs:label>物料计划参数</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MaterialRequest -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MaterialRequest">
        <rdfs:comment>缺料时的请领单,挂在工单与仓库上。</rdfs:comment>
        <rdfs:label>物料申请</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MrpRun -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MrpRun">
        <rdfs:comment>一次物料需求计划运算,带计划期与运算状态;新运算取代旧运算。</rdfs:comment>
        <rdfs:label>MRP 运算</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#MrpSuggestion -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#MrpSuggestion">
        <rdfs:comment>MRP 净算后的建议(计划生产/计划采购/提前/推迟),带需求 pegging 溯源与产能检查结果。可下发为生产工单或采购订单。</rdfs:comment>
        <rdfs:label>MRP 建议</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#NonconformanceReport -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#NonconformanceReport">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/ontology/honeymom#ncrCode"/>
        </owl:hasKey>
        <rdfs:comment>不合格品报告(NCR),带处置(待处置/返修/报废/让步接收/退供应商)与状态(待处理/评审中/已关闭)。首检不合格时自动登记 NCR 且不予放行。</rdfs:comment>
        <rdfs:label>不合格品</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#OperatorSkill -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#OperatorSkill">
        <rdfs:comment>员工在某工序/工位组上的技能等级(学徒/熟练/骨干/可带教),带有效期。排产时若某工序在某个班次内没有合格操作工,产出约束标记「无合格操作工」。</rdfs:comment>
        <rdfs:label>人员技能</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Part -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Part">
        <rdfs:comment>一件一码的实物追踪对象。状态流转:毛坯库 → 在制 → 检验合格 → 成品入库 → 已发运,旁路有返修中、冻结、报废。
铸造场景下携带炉次、浇包、砂型、型腔、浇注温度、残镁、型砂水分等追溯参数;机加场景下携带加工机床。</rdfs:comment>
        <rdfs:label>在制品</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#PartEvent -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#PartEvent">
        <rdfs:comment>零件在现场的时序事件流(流转、检验、冻结等),与 Part 一对多,按时间回放可重建当前状态。</rdfs:comment>
        <rdfs:label>零件事件</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#PatrolInspection -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#PatrolInspection">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#InspectionRecord"/>
        <rdfs:comment>检验类型取值之一:巡检。班中周期性抽查。</rdfs:comment>
        <rdfs:label>巡检</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Plant -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Plant">
        <rdfs:comment>制造实体,是车间与销售订单/采购订单的收货与发货主体。</rdfs:comment>
        <rdfs:label>工厂</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Process -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Process">
        <rdfs:comment>可被排产与报工的最小制造步骤(如熔炼、造型浇注、机加工)。工序带标准节拍,是 OEE 性能率与排产时长的计算基准。</rdfs:comment>
        <rdfs:label>工序</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#ProductionLine -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#ProductionLine">
        <rdfs:comment>车间下的连续生产单元,工位与设备挂靠其上;工单可在产线上排产。</rdfs:comment>
        <rdfs:label>产线</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#ProductionReport -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#ProductionReport">
        <rdfs:comment>现场产出记录,来源含设备自动、人工、手机扫码、扫码枪、工位终端。系统实际执行的放行闸门( services/gates.py submit_report )依次为:
(1) 幂等键 idem_key 重复提交 → 识别为重复提交,不重复计数;
(2) 零件所属批次处于冻结中 → 阻断;
(3) 本次合格数+不良数必须大于 0;
(4) 不得超过上道工序转来的合格数减去本道已报数(跳序/超量);
(5) 不得超过工序计划量 ×(1+report_over_pct/100)(超计划);
(6) 工序标记首检放行时,须已首检放行;
(7) ECN 停工中的工单 → 阻断。
以上为运行时规则,本体仅记录其语义,不以 OWL 公理表达为可执行约束。</rdfs:comment>
        <rdfs:label>报工记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#PurchaseOrder -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#PurchaseOrder">
        <rdfs:comment>对供应商的采购承诺,收货时转入库并触发来料检验。</rdfs:comment>
        <rdfs:label>采购订单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#PurchaseOrderLine -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#PurchaseOrderLine">
        <rdfs:comment>采购明细,带已收/合格入库/不合格数量,不合格部分可退供。</rdfs:comment>
        <rdfs:label>采购订单行</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#PurchaseRequisition -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#PurchaseRequisition">
        <rdfs:comment>采购需求,可由 MRP 建议生成。</rdfs:comment>
        <rdfs:label>请购单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Quotation -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Quotation">
        <rdfs:comment>对外报价,可转为销售订单。</rdfs:comment>
        <rdfs:label>报价单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#RawMaterial -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#RawMaterial">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <owl:disjointWith rdf:resource="https://example.org/ontology/honeymom#SemiFinishedMaterial"/>
        <rdfs:comment>物料类型取值之一:原材料。与其他物料类型子类互斥(mtype 单值枚举)。</rdfs:comment>
        <rdfs:label>原材料</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#RepairOrder -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#RepairOrder">
        <rdfs:comment>维修工单,状态:已报修 → 已派工 → 维修中 → 已修复 → 已验收。未修复完成的工单所涉设备在排产时视为不可用。</rdfs:comment>
        <rdfs:label>维修工单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#ReworkOrder -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#ReworkOrder">
        <rdfs:comment>返修单,必须处于「进行中」才能流转结果;返修完成后须复检(引用一条检验记录)并给出复检结论,复检不合格则返修不合格。</rdfs:comment>
        <rdfs:label>返修记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Routing -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Routing">
        <rdfs:comment>产品的工艺版本,带生效/作废状态;一条路线由若干有序工艺步骤构成,工单下达时冻结引用某一版本。</rdfs:comment>
        <rdfs:label>工艺路线</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#RoutingStep -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#RoutingStep">
        <rdfs:comment>工艺路线上的一道工序。携带决定现场行为的三个开关:是否检验点、是否首检放行、报工方式(设备自动/人工/扫码);并指定工位组与标准节拍。</rdfs:comment>
        <rdfs:label>工艺步骤</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#SalesOrder -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#SalesOrder">
        <rdfs:comment>客户订单。状态:草稿 → 信用待批 → 已确认 → 部分发货 → 已发完 → 已关闭。按单生产(mto)时,订单行会派生生产工单。</rdfs:comment>
        <rdfs:label>销售订单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#SalesOrderLine -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#SalesOrderLine">
        <rdfs:comment>订单的产品明细行,带数量、单价、交期与已发/已退数量;按单生产时关联到具体工单。</rdfs:comment>
        <rdfs:label>销售订单行</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#ScheduleProposal -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#ScheduleProposal">
        <rdfs:comment>what-if 排产假设(设备停机、到料推迟、模具保养、优先级调整)落成的建议,带受影响工单与原因。采纳后写入主数据并重排。</rdfs:comment>
        <rdfs:label>排程调整建议</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#SemiFinishedMaterial -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#SemiFinishedMaterial">
        <rdfs:subClassOf rdf:resource="https://example.org/ontology/honeymom#Material"/>
        <rdfs:comment>物料类型取值之一:半成品。经一道或多道工序加工后进入下一工序的中间件。</rdfs:comment>
        <rdfs:label>半成品</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Shift -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Shift">
        <rdfs:comment>排产与考勤使用的时间段。active=false 的班次不参与排产,设备只在启用班次内工作。</rdfs:comment>
        <rdfs:label>班次</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Shipment -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Shipment">
        <rdfs:comment>成品发运,对应工单与客户。</rdfs:comment>
        <rdfs:label>发运记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Stock -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Stock">
        <rdfs:comment>物料在仓库/库位上的当前数量,按批次(lot)分列。冻结批次仍占用库存,但不可出库。</rdfs:comment>
        <rdfs:label>库存</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#StockTransaction -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#StockTransaction">
        <rdfs:comment>库存流水:入库/出库/移库/盘点调整。移库含调入仓库。出库与移库方向受批次冻结拦截。</rdfs:comment>
        <rdfs:label>出入库记录</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#StorageLocation -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#StorageLocation">
        <rdfs:comment>仓库内的库位,带容量。库存精确到库位。</rdfs:comment>
        <rdfs:label>库位</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Supplier -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Supplier">
        <rdfs:comment>供货方,带资格(合格/试用/停用)与绩效得分;停用供应商不能下采购订单。</rdfs:comment>
        <rdfs:label>供应商</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#TagPoint -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#TagPoint">
        <rdfs:comment>设备点位定义,带地址、类型、量程缩放、采集周期与报警上下限。用途(运行状态/报警/功率/产量/主轴负载/温度/质量值)决定该点位被映射成哪类业务记录;接入时逐点确认语义,确认前不可投产。</rdfs:comment>
        <rdfs:label>采集点</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Team -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Team">
        <rdfs:comment>人员的组织单元,归属某个班次,班组长是排产技能覆盖判断的组织边界。</rdfs:comment>
        <rdfs:label>班组</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Tooling -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Tooling">
        <rdfs:comment>模具/芯盒/夹具/检具。带当前模次与寿命模次。排产约束:同一套模具同一时间只能在一台设备上;保养中的模具要到预计可用时间才能占用;剩余模次不足以完成本单时产出「模具寿命不足」提示。</rdfs:comment>
        <rdfs:label>模具夹具</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#UserAccount -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#UserAccount">
        <rdfs:comment>登录账号,绑定员工身份与角色权限;数据范围(工厂/车间/产线)决定其可见对象集合。</rdfs:comment>
        <rdfs:label>系统用户</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Warehouse -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Warehouse">
        <rdfs:comment>按类型区分原材料库、毛坯库、线边库、成品库、辅料库;委外仓表示供应商处库存。</rdfs:comment>
        <rdfs:label>仓库</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#WorkOrder -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#WorkOrder">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/ontology/honeymom#workOrderCode"/>
        </owl:hasKey>
        <rdfs:comment>生产工单是计划与现场的交接口。状态机:草稿 → 已下达 → 生产中 → 已完工 → 已关闭(可转已取消)。
业务约束:工单可因 ECN(工艺变更)被判停工,停工未解除时禁止报工(见 services/exec_doc.py 的 report_gate);该 ECN 模型不在本次本体范围内。</rdfs:comment>
        <rdfs:label>生产工单</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#WorkOrderOperation -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#WorkOrderOperation">
        <rdfs:comment>工单在工艺路线上的展开,记录计划量/合格量/不良量与实际起止。顺序(seq)是有业务含义的:上一道工序未转来足量合格品时,本道不得超量报工。</rdfs:comment>
        <rdfs:label>工单工序</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Workshop -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Workshop">
        <rdfs:comment>工厂下的生产单元,按类型区分铸造、机加、仓储等;车间类型决定下辖产线的工艺属性。</rdfs:comment>
        <rdfs:label>车间</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/ontology/honeymom#Workstation -->

    <owl:Class rdf:about="https://example.org/ontology/honeymom#Workstation">
        <rdfs:comment>产线上的作业点,可绑定设备。工位组(group)表示可互相替代的同类工位(如 CNC 群组),是排产时并行分配设备与模具的单位。</rdfs:comment>
        <rdfs:label>工位</rdfs:label>
    </owl:Class>
</rdf:RDF>



