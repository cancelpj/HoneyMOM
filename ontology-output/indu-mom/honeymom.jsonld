    "@id": "https://example.org/ontology/honeymom#standardCycleSeconds",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "完成一件的理论秒数。用于排产时长计算与 OEE 性能率基准。"
      }
