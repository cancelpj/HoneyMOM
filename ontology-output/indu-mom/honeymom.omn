Prefix: owl: <http://www.w3.org/2002/07/owl#>
Prefix: rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>
Prefix: xml: <http://www.w3.org/XML/1998/namespace>
Prefix: xsd: <http://www.w3.org/2001/XMLSchema#>
Prefix: : <https://example.org/ontology/honeymom>



Ontology: <https://example.org/ontology/honeymom>


Annotations: 
    rdfs:comment "HoneyMOM 离散制造 MES / MOM 系统的业务本体。对象类型对应业务概念,链接类型对应业务关联,数据属性对应业务属性。建模依据来自源码 honeymom/schema*.py 的实体定义与 honeymom/services/ 中的实际业务规则,不是数据库表的机械镜像。",
    rdfs:label "HoneyMOM 制造运营本体",
    owl:versionInfo "0.1.0 — 基于 Indu-mom 仓库 main 分支抽取,2026-11-16"

AnnotationProperty: owl:versionInfo

    
AnnotationProperty: rdfs:comment

    
AnnotationProperty: rdfs:label

    
Datatype: xsd:boolean

    
Datatype: xsd:date

    
Datatype: xsd:dateTime

    
Datatype: xsd:decimal

    
Datatype: xsd:integer

    
Datatype: xsd:string

    
ObjectProperty: <https://example.org/ontology/honeymom#alarmOnEquipment>

    Annotations: 
        rdfs:label "报警设备"
    
    Domain: 
        <https://example.org/ontology/honeymom#Alarm>
    
    Range: 
        <https://example.org/ontology/honeymom#Equipment>
    
    
